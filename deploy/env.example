# 研序服务端环境变量样例。复制成 .env 后按机器情况改。
# 1Panel 的「网站 → 反向代理」或 systemd 的 EnvironmentFile 都能直接吃这个文件。

# 只监听回环：公网流量一律走 1Panel 的 Nginx，这个进程不直接对外
HOST=127.0.0.1
PORT=8787

# SQLite 文件所在目录，必须是持久化目录（别放 /tmp，也别放容器临时层）
DATA_DIR=/opt/research-workspace/data

# 前面是 https 的反代时设为 1，会话 Cookie 才会带 Secure
COOKIE_SECURE=1

# 只有确认前面是可信反代时才信任 X-Forwarded-For（登录限速按 IP 计）
TRUST_PROXY=1

# 注册开关。建议：建好第一个账号后保持 0；
# 后续账号可在管理控制台创建；后台保存注册设置后，以数据库中的设置为准。
ALLOW_SIGNUP=0

# 会话有效天数（默认 30）
SESSION_TTL_DAYS=30

# 同一「邮箱+IP」在窗口内允许的失败登录次数与窗口分钟数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# 备份脚本用：备份文件保留天数
BACKUP_KEEP_DAYS=14

# 科研文件：单文件上限与每账号配额（MiB）。Nginx请求体限制应至少覆盖单文件上限。
FILE_MAX_MB=25
FILE_QUOTA_MB=500

# 平台 AI：在管理控制台选择服务商与模型，再配置对应密钥并重启服务。
# 只需填写实际使用的一个；不要把真实值提交到代码仓库。
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# 自定义兼容服务（例如自建代理或本地模型）；地址只由服务端运维配置。
AI_BASE_URL=
AI_API_KEY=
