{
  "name": "research-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "研序 · 个人科研工作管理平台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/src/main.ts",
    "server:dev": "node --env-file=deploy/dev.env.example server/src/main.ts",
    "backup": "node scripts/backup-server.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "verify:server": "node scripts/verify-server.mjs",
    "verify:restore": "node scripts/verify-restore.mjs",
    "desktop:prepare": "node node_modules/electron/install.js && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --win --x64 && node scripts/finalize-desktop.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs",
    "check:public": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "desktop/main.cjs",
  "author": "研序",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taoze190-afk/research-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/taoze190-afk/research-workspace/issues"
  },
  "homepage": "https://github.com/taoze190-afk/research-workspace#readme"
}
